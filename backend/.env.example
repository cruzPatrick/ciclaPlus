# Copie para .env (que NÃO vai para o Git) e ajuste. Nunca coloque segredos reais aqui.
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27018/ciclaplus
MONGODB_URI_TEST=mongodb://127.0.0.1:27018/ciclaplus_test

# Obrigatório em produção, mínimo 32 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Origens do frontend permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173

# Limites por IP a cada 15 minutos
RATE_LIMIT_GERAL=300
RATE_LIMIT_AUTH=10
